generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Contact form submissions
model Contact {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  inquiryType String
  message     String
  status      String   @default("new")   // new, read, replied
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// HR Health Check results
model HRHealthCheck {
  id              String   @id @default(cuid())
  name            String
  email           String
  company         String?
  overallScore    Int
  hiringScore     Int
  onboardingScore Int
  performanceScore Int
  retentionScore  Int
  hrSetupScore    Int
  recommendation  String
  status          String   @default("new")
  createdAt       DateTime @default(now())
}

// Job applications
model JobApplication {
  id          String   @id @default(cuid())
  jobTitle    String
  jobSlug     String
  name        String
  email       String
  phone       String?
  coverNote   String?
  cvUrl       String?   // Supabase storage URL
  cvFileName  String?
  status      String   @default("new")  // new, reviewing, shortlisted, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
